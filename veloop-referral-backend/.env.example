# ---------- App ----------
ENV=development
DEBUG=false
API_PREFIX=/api

# ---------- Database ----------
# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://veloop:password@localhost:5432/veloop
DATABASE_URL=sqlite:///./veloop.db
SQL_ECHO=false

# ---------- Auth ----------
JWT_SECRET=replace-with-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------- Device / fraud secrets (rotate independently) ----------
DEVICE_TOKEN_SECRET=replace-with-random-string
DEVICE_HASH_SECRET=replace-with-random-string
IP_HASH_SECRET=replace-with-random-string
DEVICE_TOKEN_EXPIRE_DAYS=180

# ---------- Ad provider ----------
AD_PROVIDER_SECRET=replace-with-random-string
AD_MIN_WATCH_SECONDS=15
AD_EVENT_MAX_AGE_SECONDS=600

# ---------- Fraud thresholds ----------
RISK_REVIEW_THRESHOLD=31
RISK_HIGH_THRESHOLD=61

# ---------- Infra ----------
REDIS_URL=
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://veloop-referral-redesign.vercel.app
REFERRAL_LINK_BASE=https://www.velooprewards.in/register

# ---------- Rate limits (requests/seconds) ----------
RATE_LIMIT_AUTH=10/60
RATE_LIMIT_ATTRIBUTE=5/300
RATE_LIMIT_AD_EVENT=60/60
RATE_LIMIT_READ=120/60
