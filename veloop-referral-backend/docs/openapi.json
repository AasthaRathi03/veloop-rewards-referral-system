  "components": {
    "schemas": {
      "AdCompleteIn": {
        "properties": {
          "provider": {
            "type": "string",
            "maxLength": 32,
            "title": "Provider",
            "default": "veloop-sdk"
          },
          "providerEventId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Providereventid"
          },
          "adUnit": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Adunit"
          },
          "watchedSeconds": {
            "type": "integer",
            "maximum": 3600.0,
            "minimum": 0.0,
            "title": "Watchedseconds"
          },
          "completedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completedat"
          },
          "signature": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Signature"
          }
        },
        "type": "object",
        "required": [
          "providerEventId",
          "watchedSeconds"
